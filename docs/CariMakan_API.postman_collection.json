            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Warung Pak Budi\",\n  \"lat\": -6.2,\n  \"lng\": 106.8,\n  \"jam_buka\": \"08:00-22:00\",\n  \"url_whatsapp\": \"https://wa.me/6281234567890\",\n  \"foto_uri\": \"https://example.com/foto.jpg\",\n  \"badges\": []\n}"
            }

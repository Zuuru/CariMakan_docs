{
  "info": {
    "name": "CariMakan API",
    "_postman_id": "carimakan-api-collection",
    "description": "Koleksi lengkap endpoint CariMakan REST API. Base URL: http://localhost:3001/v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3001/v1", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "resto_id", "value": "", "type": "string" },
    { "key": "menu_id", "value": "", "type": "string" },
    { "key": "order_id", "value": "", "type": "string" },
    { "key": "uid", "value": "", "type": "string" },
    { "key": "tag_id", "value": "", "type": "string" }

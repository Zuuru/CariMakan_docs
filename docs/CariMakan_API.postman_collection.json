  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi Santoso\",\n  \"email\": \"budi@email.com\",\n  \"phone\": \"081234567890\",\n  \"password\": \"password123\",\n  \"role\": \"customer\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }",
                  "if (json.uid) { pm.collectionVariables.set('uid', json.uid); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"budi@email.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "🍽️ Restoran",
      "item": [
        {
          "name": "Get All Restaurants",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/restaurants?status=aktif&limit=10",
              "host": ["{{base_url}}"],
              "path": ["restaurants"],
              "query": [
                { "key": "status", "value": "aktif" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Nearby Restaurants",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/restaurants/nearby?lat=-6.2&lng=106.8&radius=2000",
              "host": ["{{base_url}}"],
              "path": ["restaurants", "nearby"],
              "query": [
                { "key": "lat", "value": "-6.2" },
                { "key": "lng", "value": "106.8" },
                { "key": "radius", "value": "2000" }
              ]
            }
          }
        },
        {
          "name": "Get Restaurant Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/restaurants/{{resto_id}}",
              "host": ["{{base_url}}"],
              "path": ["restaurants", "{{resto_id}}"]
            }
          }
        },
